[Unit]
Description=Synchronize Farm repository TODO files with Tracker
After=farm-tracker.service

[Service]
Type=oneshot
User=gradywoodruff
Group=gradywoodruff
WorkingDirectory=/srv/farm/private/tracker
ExecStart=/srv/farm/private/tracker/.venv/bin/python -m tracker.sync
UMask=0077
TimeoutStartSec=180
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/data/databases/personal/tracker /srv/farm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
